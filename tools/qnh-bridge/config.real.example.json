{
  "version": "1.0.0",
  "mode": "real",
  "bindHost": "127.0.0.1",
  "port": 8768,
  "storeName": "必须与 qnhConfig.name 完全一致",
  "tenantId": "必须与 qnhConfig.tenantId 完全一致",
  "storeId": "必须与 qnhConfig.storeId 完全一致",
  "pipelineRoot": "/absolute/path/to/tools/qnh-image-pipeline",
  "qnhConfig": "/absolute/path/to/tools/qnh-image-pipeline/configs/store.json",
  "dataDir": "./.qnh-bridge-data",
  "maxImageBytes": 10485760,
  "maxRequestBytes": 83886080,
  "maxMainImages": 10,
  "maxDetailImages": 20,
  "allowedOrigins": [
    "http://127.0.0.1:5173",
    "http://127.0.0.1:5174",
    "http://127.0.0.1:5175",
    "http://127.0.0.1:5176",
    "http://localhost:5173",
    "http://localhost:5174",
    "http://localhost:5175",
    "http://localhost:5176"
  ]
}
